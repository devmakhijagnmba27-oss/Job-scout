# JobScout environment variables.
# Copy to .env and fill in real values. The real .env is gitignored —
# no credentials are ever committed (see README > Security).

# LLM Providers (Choose one or more):
# 1. Local OmniRoute Proxy (Key rotation & Load balancing):
# LLM_PROVIDER=omniroute
# OMNIROUTE_BASE_URL=http://localhost:8000/v1
# OMNIROUTE_API_KEY=your-omniroute-key-or-dummy
# JOBSCOUT_MODEL=gemini-2.5-flash

# 2. Google Gemini:
# LLM_PROVIDER=gemini
# GEMINI_API_KEY=
# JOBSCOUT_MODEL=gemini-3.6-flash

# 3. Anthropic Claude:
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...

# 4. OpenAI:
# LLM_PROVIDER=openai
# OPENAI_API_KEY=

# Optional Tier B job sources (JobScout works without these):
# Adzuna — free key at https://developer.adzuna.com/
# ADZUNA_APP_ID=
# ADZUNA_APP_KEY=

# USAJOBS — free key at https://developer.usajobs.gov/
# USAJOBS_API_KEY=
# USAJOBS_USER_AGENT=your-email@example.com

# JSearch (Google for Jobs aggregator — includes postings published on
# Indeed, Glassdoor, LinkedIn, ZipRecruiter). Free key, no card:
# https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
# JSEARCH_API_KEY=

# Hunter.io — optional Contact Discovery (find recruiter/HR contacts per
# posting; "🔍 Find contacts" button in the UI, --find-contacts on the CLI).
# Free key at https://hunter.io/api-keys
# HUNTER_API_KEY=

# Autonomous Cold Email & Outreach Configuration:
# OUTREACH_DRY_RUN: 'true' simulates dispatches safely without sending real emails.
# Set to 'false' only when you want to send live emails via your SMTP credentials.
OUTREACH_DRY_RUN=true
OUTREACH_DAILY_LIMIT=25

# SMTP Email Dispatch Settings (e.g. Gmail App Password, Outlook, Custom SMTP):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-specific-password
# SMTP_FROM_EMAIL=your-email@gmail.com
# SMTP_USE_TLS=true
# SMTP_USE_SSL=false

# Notion — optional history mirror
# NOTION_API_KEY=
# NOTION_DATABASE_ID=
